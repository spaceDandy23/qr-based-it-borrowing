# Local dev defaults below. Before deploying to the internal server:
#   APP_ENV=production
#   APP_DEBUG=false               (never true outside local dev — leaks stack traces/paths)
#   APP_URL=https://...           (use HTTPS if the server supports it)
#   Set ADMIN_EMAIL / ADMIN_PASSWORD env vars before first seed, or create the
#   admin account manually — do not leave the seeder's random password in place.
APP_NAME="Mister Babadook"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mister_babadook
DB_USERNAME=babadook_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=190

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log


FDCP_ACCOUNTS_BASE_URL=https://sso.fdcp.ph
